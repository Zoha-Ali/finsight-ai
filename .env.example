# Copy this file to .env (same directory as docker-compose.yml) and fill
# in real values before running `docker compose up`. Never commit the
# real .env file - it's already gitignored.

# Postgres connection string (this project uses Neon - a local Postgres
# container isn't part of this setup since the database is already
# externally hosted). Needs sslmode=require for Neon.
DATABASE_URL=postgresql://<user>:<pass>@<host>/<db>?sslmode=require

# Random secret used to sign JWTs - generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Anthropic API key (Claude models - claude-haiku-4-5, claude-sonnet-5)
ANTHROPIC_API_KEY=

# Groq API key (openai/gpt-oss-120b - used for "simple" categorize/Q&A routing)
GROQ_API_KEY=

# --- Optional overrides, only needed if you change the default ports in
# docker-compose.yml (backend on 8000, frontend on 5173) ---

# Comma-separated list of origins the backend's CORS middleware allows.
# Defaults to http://localhost:5173,http://127.0.0.1:5173 if unset.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Base URL the frontend's built JS uses to reach the backend - baked in
# at build time, since the browser (not the container) makes the actual
# API calls. Defaults to http://localhost:8000 if unset.
# VITE_API_BASE_URL=http://localhost:8000
